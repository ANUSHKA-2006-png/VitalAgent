# ================================
# VitalAgent - .gitignore
# ================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- Virtual Environment ----------
.venv/
venv/
env/
ENV/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Python Packaging ----------
build/
dist/
*.egg-info/
.eggs/

# ---------- Logs ----------
*.log
logs/

# ---------- Cache ----------
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Hugging Face Cache ----------
.cache/huggingface/
huggingface/
models--*/
*.safetensors

# ---------- Raw Datasets ----------
# Large datasets should NOT be pushed to GitHub
data/raw/

# ---------- Processed Datasets ----------
# Ignore all processed datasets except required split files and moment embeddings
data/processed/*
!data/processed/stress/
data/processed/stress/*
!data/processed/stress/splits/
!data/processed/stress/splits/*.npy
!data/processed/spo2/
data/processed/spo2/*
!data/processed/spo2/splits/
!data/processed/spo2/splits/*.npy
!data/processed/moment_embeddings/
!data/processed/moment_embeddings/**/*.npy

# ---------- Model Files ----------
# Ignore all model files except required serialized heads/configurations
models/*
!models/*.pkl
!models/wesad/
models/wesad/*
!models/wesad/*.json
!models/wesad/finetuned/
models/wesad/finetuned/*
!models/wesad/finetuned/*.json
!models/wesad/modality/
models/wesad/modality/*
!models/wesad/modality/bvp_probabilities/
!models/wesad/modality/bvp_probabilities/*.npy

checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.joblib
*.pkl

# ---------- NumPy / ML Outputs ----------
*.npy
*.npz

# ---------- Temporary Scratch / Audit ----------
scratch/
pyrefly.toml
pyrightconfig.json

# ---------- Exception rules for required ML model artifacts and results ----------
!results/results.csv